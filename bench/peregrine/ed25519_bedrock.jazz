export fn jasmin_ed25519_smul_bytes(reg ptr u64[4] p_ox, reg ptr u64[4] p_oy, reg const ptr u64[4] p_x, reg const ptr u64[4] p_y, reg const ptr u64[4] p_k) -> reg ptr u64[4], reg ptr u64[4] {
