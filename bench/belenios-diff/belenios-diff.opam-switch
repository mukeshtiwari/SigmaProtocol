    "ipaddr" {>= "5.6.0"}
    "ppx_sexp_conv" {>= "v0.13.0"}
    "logs"
    "uri" {>= "2.0.0"}
    "odoc" {with-doc}
  ]
  build: [
    ["dune" "subst"] {dev}
