  bug-reports: "https://github.com/mirage/ocaml-cohttp/issues"
  depends: [
    "dune" {>= "3.8"}
    "ocaml" {>= "4.08"}
    "http" {= version}
    "cohttp" {= version}
    "lwt" {>= "5.7.0"}
