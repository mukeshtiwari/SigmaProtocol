}
package "yojson" {
  opam-version: "2.0"
  version: "3.0.0"
  synopsis:
    "Yojson is an optimized parsing and printing library for the JSON format"
  description: """\
Yojson is an optimized parsing and printing library for the JSON format.

ydump is a pretty-printing command-line program provided with the
yojson package."""
  maintainer: [
    "paul-elliot@tarides.com" "nathan@tarides.com" "marek@tarides.com"
