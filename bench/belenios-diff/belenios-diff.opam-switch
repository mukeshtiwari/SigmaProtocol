    "ocamlfind" {build}
    "ocamlbuild" {build}
    "topkg" {build & >= "1.1.0"}
  ]
  depopts: ["base-unix" "cmdliner"]
  conflicts: [
    "cmdliner" {< "1.3.0"}
  ]
  build: [
    "ocaml"
    "pkg/pkg.ml"
    "build"
    "--dev-pkg"
    "%{dev}%"
    "--with-base-unix"
    "%{base-unix:installed}%"
    "--with-cmdliner"
    "%{cmdliner:installed}%"
  ]
  dev-repo: "git+https://erratique.ch/repos/fmt.git"
  url {
    src: "https://erratique.ch/software/fmt/releases/fmt-0.11.0.tbz"
    checksum:
