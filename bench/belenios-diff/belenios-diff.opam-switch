      "build"
      "-p"
      name
      "-j"
      jobs
      "@install"
      "@cohttp-lwt/runtest" {with-test}
      "@doc" {with-doc}
    ]
  ]
  dev-repo: "git+https://github.com/mirage/ocaml-cohttp.git"
